}

// â”€â”€â”€ Container Hierarchy â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Container {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  type           ContainerType
  description    String?
  address        String?
  city           String?
  country        String?
  coverImage     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  properties   Property[]
  managers     ContainerManager[]

  @@index([organizationId])
  @@index([branchId])
}

model ContainerManager {
  id          String   @id @default(cuid())
  containerId String
  userId      String
  role        String
  assignedAt  DateTime @default(now())

  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([containerId])
  @@index([userId])
}

// â”€â”€â”€ Vacating & Move-Out Workflow â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model VacatingNotice {
  id               String         @id @default(cuid())
  leaseId          String         @unique
  unitId           String
  tenantId         String
  organizationId   String
  noticeDate       DateTime       @default(now())
  intendedMoveOut  DateTime
  enforcedMoveOut  DateTime
  noticePeriodDays Int            @default(30)
  status           VacatingStatus @default(PENDING)
  tenantNote       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  lease         Lease              @relation(fields: [leaseId], references: [id])
  unit          Unit               @relation(fields: [unitId], references: [id])
  inspection    MoveOutInspection?
  depositRefund DepositRefund?

  @@index([organizationId, status])
  @@index([unitId])
  @@index([tenantId])
}

model MoveOutInspection {
  id               String           @id @default(cuid())
  vacatingNoticeId String           @unique
  organizationId   String
  scheduledDate    DateTime
  status           InspectionStatus @default(PROPOSED)
  inspectedBy      String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  vacatingNotice VacatingNotice        @relation(fields: [vacatingNoticeId], references: [id])
  deductions     InspectionDeduction[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model InspectionDeduction {
  id             String   @id @default(cuid())
  inspectionId   String
  description    String
  amount         Float
  category       String? // DAMAGE, MISSING_ITEM, CLEANING, UTILITY_BALANCE, LEASE_VIOLATION
  responsibility String? // TENANT, LANDLORD, WEAR_TEAR, CONTRACTOR, UNKNOWN
  status         String   @default("proposed")
  photoUrl       String?
  createdAt      DateTime @default(now())

  inspection MoveOutInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model DepositRefund {
  id               String       @id @default(cuid())
  vacatingNoticeId String       @unique
  organizationId   String
  depositAmount    Float
  totalDeductions  Float        @default(0)
  refundAmount     Float
  status           RefundStatus @default(PENDING)
  voucherNumber    String?
  paidAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  vacatingNotice VacatingNotice @relation(fields: [vacatingNoticeId], references: [id])

  @@index([organizationId, status])
}

model DepositEscrow {
  id                String   @id @default(cuid())
  leaseId           String   @unique
  organizationId    String
  tenantId          String
  landlordId        String?
  propertyId        String
  unitId            String
  model             String   @default("LANDLORD_RESERVE") // LANDLORD_RESERVE or DEPOSIT_ESCROW
  baseAmount        Float    @default(0)
  currentBalance    Float    @default(0)
  status            String   @default("active") // active, captured, refunded, disputed
  topUpLog          Json?
  heldSince         DateTime @default(now())
  walletWatchActive Boolean  @default(false)
  healthStatus      String   @default("fully_covered") // fully_covered, at_risk, shortfall
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([tenantId])
  @@index([landlordId])
  @@index([propertyId])
  @@index([unitId])
  @@index([healthStatus])
}

model DepositTopUpRequest {
  id                String    @id @default(cuid())
  leaseId           String
  organizationId    String
  requestedBy       String // tenant, landlord, system
  amount            Float
  reason            String
  status            String    @default("pending") // pending, accepted, disputed, expired
  respondedBy       String?
  respondedAt       DateTime?
  disputeResolution String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([leaseId, status])
  @@index([organizationId, status])
  @@index([requestedBy])
}

model LandlordRefundScore {
  id              String   @id @default(cuid())
  landlordId      String   @unique
  score           String   @default("prompt") // prompt, late, disputed
  totalRefunds    Int      @default(0)
  onTimeRefunds   Int      @default(0)
  disputedRefunds Int      @default(0)
  lastUpdated     DateTime @default(now())

  @@index([score])
}

// â”€â”€â”€ Move-In Checklist â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ChecklistTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  category       String? // RESIDENTIAL, FURNISHED, COMMERCIAL, SHORT_STAY, CUSTOM
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items            ChecklistTemplateItem[]
  tenantChecklists TenantChecklist[]

  @@index([organizationId])
}

model ChecklistTemplateItem {
  id             String  @id @default(cuid())
  templateId     String
  section        String // also used as "Area"
  item           String
  defaultQty     Int     @default(1)
  order          Int
  isUtilityMeter Boolean @default(false) // numeric meter readings instead of condition selects

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, order])
}

model TenantChecklist {
  id         String        @id @default(cuid())
  leaseId    String
  unitId     String
  tenantId   String
  templateId String
  type       ChecklistType
  status     String        @default("PENDING")
  signedAt   DateTime?
  checklistData Json?
  signedByTenant Boolean   @default(false)
  signedByLandlord Boolean @default(false)
  gpsVerified Boolean      @default(false)
  createdAt  DateTime      @default(now())

  lease    Lease                  @relation(fields: [leaseId], references: [id])
  unit     Unit                   @relation(fields: [unitId], references: [id])
  template ChecklistTemplate      @relation(fields: [templateId], references: [id])
  entries  TenantChecklistEntry[]

  @@index([leaseId])
  @@index([unitId])
  @@index([tenantId])
  @@index([templateId])
  @@index([status])
}

model TenantChecklistEntry {
  id                 String    @id @default(cuid())
  checklistId        String
  itemId             String
  condition          String // legacy/general condition (mirrors statusOut when present)
  qty                Int?
  statusIn           String? // condition at move-in
  statusOut          String? // condition at move-out
  chargeKes          Float? // deposit-deduction charge for this row
  replacementCostKes Float? // estimated replacement cost for furnished unit items
  followUpDate       DateTime? // scheduled follow-up date for maintenance items
  evidenceScore      String? // STRONG, MEDIUM, WEAK — based on uploaded evidence quality
  responsibility     String? // TENANT, LANDLORD, WEAR_TEAR, CONTRACTOR, UNKNOWN
  actionRequired     String? // REPAIR, REPLACE, MONITOR, NO_ACTION
  note               String?
  photoUrl           String?
  photoInUrl         String?
  photoOutUrl        String?
  customFields       Json?

  checklist TenantChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

// â”€â”€â”€ Listing Module â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Listing {
  id             String        @id @default(cuid())
  organizationId String
  unitId         String        @unique
  title          String
  description    String?
  rentAmount     Float
  currency       String        @default("KES")
  availableFrom  DateTime
  leaseDuration  String?
  furnished      Boolean       @default(false)
  petFriendly    Boolean       @default(false)
  features       String[]
  photos         String[]
  status         ListingStatus @default(DRAFT)
  depositModel   String        @default("LANDLORD_RESERVE")
  escrowBadge    Boolean       @default(false)
  fullyCoveredBadge Boolean    @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  unit           Unit                @relation(fields: [unitId], references: [id])
  applications   RentalApplication[]
  qrApplications QrApplication[]

  @@index([organizationId, status])
}

model RentalApplication {
  id          String            @id @default(cuid())
  listingId   String
  applicantId String
  message     String?
  status      ApplicationStatus @default(PENDING)
  reviewerId  String?
  reviewedAt  DateTime?
  adminNotes  String?
  submittedAt DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  listing           Listing                       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  evidences         ApplicationEvidence[]
  customFieldValues ApplicationCustomFieldValue[]

  @@index([listingId, status])
  @@index([applicantId])
  @@index([status])
}

// â”€â”€â”€ Accounting Enhancements â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model MonthlyRentSummary {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  periodYear     Int
  periodMonth    Int
  openingBalance Float    @default(0)
  totalRentDue   Float    @default(0)
  totalCollected Float    @default(0)
  totalArrears   Float    @default(0)
  closingBalance Float    @default(0)
  totalExpenses  Float    @default(0)
  notes          String?
  generatedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, periodYear, periodMonth])
  @@index([organizationId])
  @@index([branchId])
}

// â”€â”€â”€ Role Context â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model UserRoleContext {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  containerId    String?
  role           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([organizationId])
  @@index([containerId])
}

// â”€â”€â”€ Supporting Services â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  tagline     String?
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enquiries ServiceEnquiry[]

  @@index([isActive, order])
}

model ServiceEnquiry {
  id                String        @id @default(cuid())
  organizationId    String?
  userId            String?
  serviceCategoryId String
  name              String
  email             String
  phone             String?
  message           String
  status            EnquiryStatus @default(NEW)
  assignedTo        String?
  assignedAt        DateTime?
  resolvedAt        DateTime?
  internalNotes     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id])

  @@index([serviceCategoryId, status])
  @@index([status, createdAt])
  @@index([organizationId])
  @@index([userId])
  @@index([assignedTo])
  @@index([organizationId, status])
}

// â”€â”€â”€ Airbnb / Short-Stay Module â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model SupportTicket {
  id              String   @id @default(cuid())
  ticketNumber    String   @unique
  organizationId  String?
  userId          String?
  name            String
  email           String
  phone           String?
  category        String
  priority        String   @default("NORMAL")
  assignedTo      String?
  status          String   @default("NEW")
  sla             String?
  internalNotes   String?
  resolutionNotes String?
  message         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, status])
  @@index([userId])
  @@index([assignedTo])
  @@index([status, createdAt])
}

model ContactRequest {
  id             String   @id @default(cuid())
  contactNumber  String   @unique
  organizationId String?
  name           String
  email          String
  phone          String?
  message        String
  source         String   @default("website")
  assignedTo     String?
  status         String   @default("NEW")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
  @@index([assignedTo])
  @@index([status, createdAt])
}

model CrmLead {
  id                  String   @id @default(cuid())
  leadNumber          String   @unique
  organizationId      String?
  name                String
  email               String
  phone               String?
  message             String
  leadType            String
  priority            String   @default("NORMAL")
  pipeline            String
  propertyRequirement String?
  budget              String?
  preferredLocation   String?
  status              String   @default("NEW")
  assignedTo          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([organizationId, status])
  @@index([leadType, status])
  @@index([assignedTo])
}

model ShortStayProperty {
  id             String   @id @default(cuid())
  unitId         String   @unique
  organizationId String
  checkInTime    String   @default("14:00")
  checkOutTime   String   @default("11:00")
  nightlyRate    Float
  currency       String   @default("KES")
  cleaningFee    Float    @default(0)
  minNights      Int      @default(1)
  maxNights      Int      @default(30)
  houseRules     String?
  wifiPassword   String?
  accessNotes    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  unit         Unit               @relation(fields: [unitId], references: [id])
  bookings     ShortStayBooking[]
  stock        StockItem[]
  otherCharges OtherCharge[]

  @@index([organizationId])
}

model ShortStayBooking {
  id              String        @id @default(cuid())
  shortStayId     String
  organizationId  String
  guestName       String
  guestEmail      String
  guestPhone      String?
  guestIdNumber   String?
  checkInDate     DateTime
  checkOutDate    DateTime
  checkInTime     String?
  checkOutTime    String?
  numberOfGuests  Int           @default(1)
  totalAmount     Float
  amountPaid      Float         @default(0)
  status          BookingStatus @default(CONFIRMED)
  specialRequests String?
  internalNotes   String?
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  shortStay    ShortStayProperty   @relation(fields: [shortStayId], references: [id])
  stockUsage   BookingStockUsage[]
  otherCharges OtherCharge[]

  @@index([shortStayId, status])
  @@index([organizationId, checkInDate])
  @@index([organizationId, status])
}

model StockItem {
