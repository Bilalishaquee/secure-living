  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId, status])
  @@index([status])
}

model SlaPolicy {
  id                        String   @id @default(cuid())
  name                      String
  serviceType               String
  responseDeadlineMinutes   Int      @default(60)
  completionDeadlineMinutes Int      @default(1440)
  escalationAfterMinutes    Int      @default(120)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([serviceType])
}

model ServiceProvider {
  id                String           @id @default(cuid())
  userId            String           @unique
  organizationId    String?
  category          ProviderCategory @default(LANDLORD_PREFERRED)
  status            ProviderStatus   @default(PENDING_APPROVAL)
  specializations   String[]
  coverageAreas     String[]
  bio               String?
  qrCodeUrl         String?
  verificationLevel String           @default("Unverified")
  trustScore        Float            @default(0)
  suspensionReason  String?
  blacklistReason   String?
  suspendedAt       DateTime?
  blacklistedAt     DateTime?
  approvedAt        DateTime?
  approvedBy        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  auditLogs   ServiceProviderAuditLog[]
  performance ServiceProviderPerformance?

  @@index([organizationId, status])
  @@index([userId])
}

model ServiceProviderAuditLog {
  id         String   @id @default(cuid())
  providerId String
  action     String
  fromStatus String?
  toStatus   String?
  reason     String?
  reviewedBy String
  createdAt  DateTime @default(now())

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
}

model ServiceProviderPerformance {
  id                 String   @id @default(cuid())
  providerId         String   @unique
  responseTimeSec    Float    @default(0)
  completionTimeSec  Float    @default(0)
  disputeRate        Float    @default(0)
  reassignmentRate   Float    @default(0)
  cancellationRate   Float    @default(0)
  reworkRate         Float    @default(0)
  totalJobsCompleted Int      @default(0)
  updatedAt          DateTime @updatedAt

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model OutboxEvent {
  id               String    @id @default(cuid())
  eventType        String
  payload          Json
  processed        Boolean   @default(false)
  retryCount       Int       @default(0)
  createdAt        DateTime  @default(now())
  processedAt      DateTime?
  serviceRequestId String?

  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  @@index([processed, createdAt])
  @@index([eventType])
  @@index([serviceRequestId])
}

model CustomTypeDefinition {
  id              String      @id @default(cuid())
  name            String      @unique
  metadataSchema  Json
  serviceMode     ServiceMode @default(MANAGED)
  defaultPriority SrPriority  @default(NORMAL)
  slaPolicyId     String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model ServiceTypeConfig {
  id                         String   @id @default(cuid())
  serviceType                String   @unique
  quoteRequired              Boolean  @default(false)
  supervisorApprovalRequired Boolean  @default(false)
  evidenceRequirements       String[]
  assignmentRestrictions     String   @default("open")
  escrowRules                String?
  slaPolicyId                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// â”€â”€â”€ Subscription Package â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Package {
  id                         String      @id @default(cuid())
  name                       String      @unique
  tier                       PackageTier @unique
  listingSlots               Int
  hasServiceRequests         Boolean     @default(true)
  serviceRequestMonthlyLimit Int? // null = unlimited; 0 = blocked
  monthlyPriceKes            Decimal     @default(0)
  isListingOnly              Boolean     @default(false)
  annualDiscountEligible     Boolean     @default(true)
  overageSlotFeeKes          Decimal     @default(150)
  isActive                   Boolean     @default(true)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  userSubscriptions UserPackageSubscription[]
}

model UserPackageSubscription {
  id               String    @id @default(cuid())
  userId           String
  organizationId   String?
  packageId        String
  status           String    @default("active") // trial, active, suspended, cancelled, expired
  billingCycle     String    @default("monthly") // monthly, annual
  startedAt        DateTime  @default(now())
  nextBillingAt    DateTime?
  trialEndsAt      DateTime?
  suspendedAt      DateTime?
  canceledAt       DateTime?
  expiredAt        DateTime?
  acquisitionSource String   @default("direct") // direct, referral, partner
  referralId       String?
  renewalReminderAt DateTime?
  srUsedThisMonth  Int       @default(0)
  srCounterResetAt DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  package Package @relation(fields: [packageId], references: [id])
  billingHistory SubscriptionBillingHistory[]
  referral Referral? @relation(fields: [referralId], references: [id])

  @@index([userId, status])
  @@index([organizationId])
  @@index([packageId])
  @@index([organizationId, status])
  @@index([acquisitionSource])
  @@index([referralId])
}

model SubscriptionBillingHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  organizationId String?
  userId         String
  packageId      String
  billingCycle   String
  amountKes      Decimal  @default(0)
  invoiceNumber  String   @unique
  status         String   @default("pending") // pending, paid, failed, waived, cancelled
  paymentMethod  String?
  paymentReference String?
  periodStart    DateTime
  periodEnd      DateTime
  issuedAt       DateTime @default(now())
  paidAt         DateTime?
  notes          String?

  subscription UserPackageSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([userId, issuedAt])
  @@index([subscriptionId, issuedAt])
}

model ReferralCode {
  id             String   @id @default(cuid())
  code           String   @unique
  referrerUserId String
  referrerRole   String
  organizationId String?
  rewardType     String   @default("free_subscription_period")
  rewardValue    String   @default("1_month")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  referrals Referral[]

  @@index([referrerUserId])
  @@index([organizationId])
  @@index([isActive])
}

model Referral {
  id                String   @id @default(cuid())
  referralCodeId    String
  referredUserId    String?
  referredEmail     String?
  referredName      String?
  status            String   @default("invited") // invited, registered, verified, qualified, rewarded
  acquisitionSource String   @default("referral")
  qualificationNote String?
  rewardType        String?
  rewardValue       String?
  rewardEligible    Boolean  @default(false)
  rewardApprovedAt  DateTime?
  rewardApprovedBy  String?
  rewardIssuedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  subscriptions UserPackageSubscription[]
  activity ReferralActivity[]

  @@index([status])
  @@index([referredUserId])
  @@index([referredEmail])
  @@index([referralCodeId, status])
  @@index([acquisitionSource])
}

model ReferralActivity {
  id          String   @id @default(cuid())
  referralId String
  actorUserId String?
  eventType   String
  note        String?
  createdAt   DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId, createdAt])
  @@index([eventType])
}

// â”€â”€â”€ Account Freeze & Appeals â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AccountFreeze {
  id             String       @id @default(cuid())
  userId         String
  freezeType     FreezeType
  status         FreezeStatus @default(ACTIVE)
  reason         String
  requiredAction String?
  appliedBy      String // admin user id or "system"
  appliedAt      DateTime     @default(now())
  liftedAt       DateTime?
  liftedBy       String?
  liftReason     String?
  notifiedAt     DateTime?
  createdAt      DateTime     @default(now())

  user    AppUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appeals FreezeAppeal[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model FreezeAppeal {
  id             String       @id @default(cuid())
  freezeId       String
  userId         String
  reason         String
  evidenceUrls   String[]
  status         AppealStatus @default(SUBMITTED)
  submittedAt    DateTime     @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
  decisionReason String?
  isSecondAppeal Boolean      @default(false)

  freeze AccountFreeze @relation(fields: [freezeId], references: [id], onDelete: Cascade)
  user   AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([freezeId])
  @@index([userId, status])
  @@index([status])
}

// â”€â”€â”€ Blacklist â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model BlacklistEntry {
  id                 String    @id @default(cuid())
  nationalIdHash     String?
  phoneNumbers       String[]
  emailAddresses     String[]
  deviceFingerprints String[]
  reason             String
  evidenceLinks      String[]
  addedBy            String
  addedAt            DateTime  @default(now())
  reviewedAt         DateTime?
  reviewedBy         String?

  @@index([nationalIdHash])
}

// â”€â”€â”€ Admin Document Requests â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model UserDocumentRequest {
  id              String                     @id @default(cuid())
  userId          String
  requestedBy     String
  documentType    String
  description     String?
  deadline        DateTime?
  enforcement     DocumentRequestEnforcement @default(REMINDER)
  status          DocumentRequestStatus      @default(PENDING)
  uploadedDocUrl  String?
  uploadedAt      DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, deadline])
}

// â”€â”€â”€ Utility Management â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model UtilityMeter {
  id              String       @id @default(cuid())
  unitId          String
  meterNumber     String
  type            UtilityType
  billingModel    BillingModel @default(FLAT_RATE)
  pricePerUnitKes Float? // tariff per consumed unit; cost = consumption * pricePerUnitKes
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  readings UtilityReading[]

  @@index([unitId, isActive])
}

model UtilityReading {
  id                String         @id @default(cuid())
  meterId           String
  readingDate       DateTime
  previousReading   Float
  currentReading    Float
  consumption       Float
  flatRateAmountKes Float?
  pricePerUnitKes   Float? // tariff applied at time of reading
  costKes           Float? // computed: consumption * pricePerUnitKes (or flatRateAmountKes)
  notes             String?
  imageUrl          String?
  createdBy         String
  isDisputed        Boolean        @default(false)
  disputeStatus     DisputeStatus?
  originalReadingId String? // set on revision records
  revisionReason    String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  meter    UtilityMeter     @relation(fields: [meterId], references: [id], onDelete: Cascade)
  disputes UtilityDispute[]

  @@index([meterId, readingDate])
  @@index([createdBy])
}

model ServiceCharge {
  id               String           @id @default(cuid())
  propertyId       String
  name             String
  allocationMethod AllocationMethod @default(PRO_RATA)
  amountKes        Decimal? // required when FLAT_AMOUNT
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([propertyId, isActive])
}

model UtilityDispute {
  id                  String        @id @default(cuid())
  readingId           String
  raisedByUserId      String
  reason              String
  status              DisputeStatus @default(OPEN)
  landlordResponse    String?
  landlordRespondedAt DateTime?
  adminDecision       String?
  adminDecidedAt      DateTime?
  adminDecidedBy      String?
  resolvedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  reading UtilityReading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([readingId, status])
  @@index([status])
}

// â”€â”€â”€ Phase 3 New Models â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// â”€â”€â”€ 1. CRM Dashboard Customization â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model DashboardWidget {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  widgetType     String // e.g. "properties_overview", "rent_collected", "occupancy", "maintenance", "visitors", "compliance", "income"
  label          String?
  position       Int      @default(0)
  isVisible      Boolean  @default(true)
  configJson     Json? // widget-specific configuration (filters, date range, etc.)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, widgetType])
  @@index([userId, position])
  @@index([organizationId])
}

// â”€â”€â”€ 2. Application Form + Evidence â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ApplicationCustomField {
  id             String   @id @default(cuid())
  organizationId String
  fieldLabel     String
  fieldType      String // text, dropdown, checkbox, upload, date, number
  fieldOptions   String[] // dropdown options
  isRequired     Boolean  @default(false)
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fieldValues ApplicationCustomFieldValue[]

  @@index([organizationId, isActive])
}

model ApplicationCustomFieldValue {
  id            String  @id @default(cuid())
  applicationId String
  fieldId       String
  value         String?
  fileUrl       String?

  application RentalApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  field       ApplicationCustomField @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([fieldId])
}

model ApplicationEvidence {
  id            String   @id @default(cuid())
  applicationId String
  evidenceType  String // e.g. "id_front", "id_back", "payslip", "bank_statement", "cr12", "guarantor", "photo", "proof_of_address"
  fileName      String
  mimeType      String
  filePath      String
  fileSizeBytes Int
  isRequired    Boolean  @default(false)
  uploadedAt    DateTime @default(now())

  application RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Enhance RentalApplication with new fields
// Adding: evidenceEnabled, customFieldsEnabled, reviewerId, reviewedAt, notes

// â”€â”€â”€ 3. Onboarding Custom Fields â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model PropertyOnboardingConfig {
  id                      String   @id @default(cuid())
  propertyId              String   @unique
  isShortStayEnabled      Boolean  @default(false)
  visitorApprovalRequired Boolean  @default(false)
  gateAccessRequired      Boolean  @default(false)
  maintenanceSla          String?
  customOnboardingFields  Json? // flexible JSON for landlord-specific fields
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// â”€â”€â”€ 4. Data Migration & Past Rent Records â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model DataImportJob {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  importType     String // "properties", "units", "tenants", "leases", "past_rent", "utilities"
  fileName       String
  fileFormat     String // "csv", "excel", "json"
  recordCount    Int       @default(0)
  successCount   Int       @default(0)
  errorCount     Int       @default(0)
  errorsJson     Json? // array of error details
  columnMapping  Json? // column mapping configuration
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  completedAt    DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([importType, createdAt])
  @@index([branchId])
  @@index([createdBy])
}

model PastRentRecord {
  id             String    @id @default(cuid())
  organizationId String
  tenantId       String
  unitId         String
  propertyId     String?
  periodYear     Int
  periodMonth    Int
  rentAmountKes  Float
  paidAmountKes  Float     @default(0)
  balanceKes     Float     @default(0)
  dueDate        DateTime?
  paidDate       DateTime?
  paymentMethod  String? // mpesa, bank, cash, etc.
  mpesaReference String?
  notes          String?
  importJobId    String?
  isMigrated     Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, unitId, periodYear, periodMonth])
  @@index([organizationId, tenantId])
  @@index([tenantId, periodYear, periodMonth])
  @@index([unitId])
  @@index([propertyId])
}

// â”€â”€â”€ 5. Rent Receipts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model RentReceipt {
  id              String    @id @default(cuid())
  invoiceId       String
  receiptNumber   String    @unique
  tenantId        String
  landlordId      String
  propertyId      String
  unitId          String
  amountKes       Float
  paymentMethod   String
  mpesaReference  String?
  bankReference   String?
  receiptDate     DateTime  @default(now())
  deliveryChannel String? // email, whatsapp, pdf, print
  deliveredAt     DateTime?
  pdfUrl          String? // generated PDF URL
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([invoiceId])
  @@index([tenantId, receiptDate])
  @@index([receiptNumber])
  @@index([unitId])
  @@index([propertyId])
}

// â”€â”€â”€ 6. Utility Linked to Rent (Household) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model UtilityHouseholdCharge {
  id               String    @id @default(cuid())
  unitId           String
  propertyId       String
  invoiceId        String?
  utilityReadingId String?
  name             String // water, electricity, garbage, internet, security, cleaning, parking, wifi, etc.
  amountKes        Float
  billingMethod    String // metered, fixed, variable, shared, included_in_rent
  periodStart      DateTime?
  periodEnd        DateTime?
  isLinkedToRent   Boolean   @default(true) // when true, appears on rent invoice
  evidenceUrl      String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([unitId, isLinkedToRent])
  @@index([invoiceId])
  @@index([propertyId])
}

// â”€â”€â”€ 7. Nightgrab / Other Charges (Short Stay) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model OtherCharge {
  id           String   @id @default(cuid())
  shortStayId  String
  bookingId    String?
  name         String // cleaning, breakfast, airport_pickup, laundry, late_checkout, deposit, custom
  description  String?
  amountKes    Float
  chargeType   String // fixed, percentage, seasonal, optional
  isRefundable Boolean  @default(false)
  isOptional   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shortStay ShortStayProperty? @relation(fields: [shortStayId], references: [id], onDelete: Cascade)
  booking   ShortStayBooking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([shortStayId])
  @@index([bookingId])
}

// â”€â”€â”€ 8. Property Sale / Ownership Transfer â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model PropertyTransferRecord {
  id              String    @id @default(cuid())
  propertyId      String
  previousOwnerId String
  newOwnerId      String
  transferDate    DateTime  @default(now())
  transferType    String // sale, gift, inheritance, company_transfer
  saleAmountKes   Float?
  notes           String?
  preservedJson   Json? // snapshot of preserved data (tenants, leases, balances, utilities, receipts)
  completedAt     DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([previousOwnerId])
  @@index([newOwnerId])
  @@index([createdBy])
}

// â”€â”€â”€ 9. Lease Template Upload â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model LeaseTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  fileUrl        String // uploaded PDF/Word file URL
  fileFormat     String // pdf, docx
  fileSizeBytes  Int?
  isActive       Boolean  @default(true)
  propertyId     String? // optional: specific to a property
  unitId         String? // optional: specific to a unit
  assignedCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, isActive])
  @@index([propertyId])
  @@index([unitId])
}

// â”€â”€â”€ 10. MoveScore & Live Intelligence â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model MoveScoreRecord {
  id            String    @id @default(cuid())
  propertyId    String
  unitId        String?
  score         Float // 0-100
  riskLevel     String // low, medium, high
  factorsJson   Json? // contributing factors
  predictedDate DateTime?
  generatedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([propertyId])
  @@index([unitId])
  @@index([score])
}

model LiveIntelligenceSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  snapshotType   String // moveout_risk, vacancy_trend, utility_trend, payment_behavior
  label          String
  value          Float
  previousValue  Float?
  trend          String // up, down, stable
  dataJson       Json?
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([organizationId, snapshotType])
  @@index([generatedAt])
}

// â”€â”€â”€ 11. Rent Score â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model RentScoreRecord {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  score            Int // 0-100
  consistency      Float // payment consistency score
  totalPaidOnTime  Int      @default(0)
  totalPaidLate    Int      @default(0)
  totalArrears     Float    @default(0)
  averageDaysEarly Int      @default(0)
  lastUpdatedAt    DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([score])
}

// â”€â”€â”€ 12. Secure Living Compliance Number â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model ComplianceNumber {
  id             String    @id @default(cuid())
  organizationId String
  tenantId       String
  propertyId     String?
  unitId         String?
  complianceId   String    @unique // e.g. SLC-NAI-004821
  status         String    @default("ACTIVE") // ACTIVE, SUSPENDED, EXPIRED, REVOKED
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  records ComplianceRecord[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([status])
  @@index([complianceId])
  @@index([unitId])
  @@index([propertyId])
  @@index([organizationId, status])
}

model ComplianceRecord {
  id                 String   @id @default(cuid())
  complianceNumberId String
  recordType         String // tenant_verification, property_inspection, lease_audit, utility_check, visitor_compliance, microbehavior
  status             String // PASS, FAIL, PENDING, WAIVED
  description        String?
  evidenceUrl        String?
  checkedBy          String
  checkedAt          DateTime @default(now())
  createdAt          DateTime @default(now())

  complianceNumber ComplianceNumber @relation(fields: [complianceNumberId], references: [id], onDelete: Cascade)

  @@index([complianceNumberId])
  @@index([recordType, status])
  @@index([status])
}

// â”€â”€â”€ 13. MicroBehavior â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model MicroBehaviorRecord {
  id           String   @id @default(cuid())
  tenantId     String
  behaviorType String // early_payment, utility_spike, visitor_frequency, repeated_complaint, late_payment, maintenance_request_pattern
  label        String // "Pays on the 2nd of each month", "Utility spike detected"
  value        String?
  score        Float? // influence score
  detectedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([behaviorType, detectedAt])
}

// â”€â”€â”€ 14. QR Applications & Access â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model QrApplication {
  id             String   @id @default(cuid())
  listingId      String?
  unitId         String?
  applicantName  String
  applicantPhone String
  applicantEmail String?
  qrToken        String   @unique
  status         String // PENDING, VERIFIED, APPLIED, COMPLETED, EXPIRED
  metadataJson   Json?
  scannedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([unitId])
  @@index([status])
}

model QrAccessLog {
  id         String   @id @default(cuid())
  qrToken    String
  userId     String?
  visitorId  String?
  accessType String // entry, exit, gate, unit_door, amenity
  granted    Boolean  @default(true)
  reason     String?
  accessedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([qrToken])
  @@index([userId])
  @@index([visitorId])
  @@index([accessedAt])
}

// â”€â”€â”€ 15. Visitors Management â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Visitor {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String?
  unitId         String?
  name           String
  phone          String?
  email          String?
  idNumber       String?
  vehicleNumber  String?
  photoUrl       String?
  isBlacklisted  Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logs VisitorLog[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([phone])
  @@unique([organizationId, phone])
}

model VisitorLog {
  id             String    @id @default(cuid())
  visitorId      String
  propertyId     String?
  unitId         String?
  purpose        String
  checkInAt      DateTime  @default(now())
  checkOutAt     DateTime?
  authorizedBy   String? // tenant or caretaker user ID
  approvalStatus String // PENDING, APPROVED, DENIED, AUTO_APPROVED
  approvalMethod String? // tenant, caretaker, auto, qr
  notes          String?
  idVerified     Boolean   @default(false)
  createdAt      DateTime  @default(now())

  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId, checkInAt])
  @@index([propertyId, checkInAt])
  @@index([unitId, approvalStatus])
  @@index([approvalStatus])
}

// â”€â”€â”€ Deposit Transfer â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model DepositTransfer {
  id                    String                @id @default(cuid())
  leaseId               String
  outgoingTenantId      String
  propertyId            String
  unitId                String
  depositAmountKes      Decimal
  platformFeeKes        Decimal               @default(500)
  incomingTenantId      String?
  status                DepositTransferStatus @default(LISTED)
  listedAt              DateTime              @default(now())
  buyerPaidAt           DateTime?
  landlordApprovedAt    DateTime?
  inspectionCompletedAt DateTime?
  releasedAt            DateTime?
  expiresAt             DateTime
  cancelledAt           DateTime?
  escrowAccountId       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([outgoingTenantId, status])
  @@index([unitId, status])
  @@index([status, expiresAt])
  @@index([propertyId])
  @@index([leaseId])
}
