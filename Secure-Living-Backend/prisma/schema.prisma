generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€ Enums â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum VerificationLevel {
  UNVERIFIED // 0 â€“ account only
  IDENTITY_VERIFIED // 1 â€“ Didit.me face match
  COMPLIANCE_VERIFIED // 2 â€“ IPRS confirmed
  TRUSTED_PERSONNEL // 3 â€“ Good Conduct + history
  ENTERPRISE_VERIFIED // 4 â€“ agency/business full review
}

enum FreezeType {
  SOFT // prevents new listings & SR creation
  HARD // hides listings, suspends account
}

enum FreezeStatus {
  ACTIVE
  LIFTED
  EXPIRED
}

enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  UPHELD
  OVERTURNED
}

enum UtilityType {
  WATER
  ELECTRICITY
}

enum BillingModel {
  FLAT_RATE
  SUB_METERED_MANUAL
  SUB_METERED_IOT
}

enum AllocationMethod {
  PRO_RATA
  FLAT_AMOUNT
}

enum DisputeStatus {
  OPEN
  LANDLORD_RESPONDED
  ESCALATED
  RESOLVED_ACCEPTED
  RESOLVED_REJECTED
}

enum DepositTransferStatus {
  LISTED
  BUYER_PAID
  LANDLORD_APPROVED
  INSPECTION_COMPLETE
  RELEASED
  EXPIRED
  CANCELLED
}

enum PackageTier {
  FREE
  LISTING_ONLY
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
  CUSTOM
}

enum TrustedPersonnelStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

enum DocumentRequestEnforcement {
  REMINDER
  SOFT_FREEZE
  HARD_FREEZE
}

enum DocumentRequestStatus {
  PENDING
  UPLOADED
  APPROVED
  REJECTED
  EXPIRED
}

enum ContainerType {
  STANDALONE
  ESTATE
  COMPLEX
  COURTYARD
  MALL
}

enum VacatingStatus {
  PENDING
  ACKNOWLEDGED
  INSPECTION_SCHEDULED
  INSPECTION_DONE
  DEPOSIT_PROCESSING
  COMPLETED
}

enum InspectionStatus {
  PROPOSED
  ACCEPTED
  RESCHEDULED
  COMPLETED
}

enum RefundStatus {
  PENDING
  APPROVED
  PAID
  DISPUTED
}

enum ChecklistType {
  MOVE_IN
  MOVE_OUT
  INSPECTION
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  UNDER_OFFER
  LET
  WITHDRAWN
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

// â”€â”€â”€ Phase 3 Enums â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum ServiceRequestType {
  MAINTENANCE
  INSPECTION
  LEGAL
  PROXY
  VALUATION
  CLEANING
  FOOD_DELIVERY
  AIRPORT_TRANSFER
  GUEST_ASSISTANCE
